# 自建 PostgreSQL + 现有 Supabase Storage 的生产运行时样板。
# 复制到服务器私有 .env；替换密码后 chmod 600，禁止提交真实值。

CONTENT_API_ENABLED=1
NEXT_PUBLIC_CONTENT_API_BASE_URL=/agent-build/api/content/v1
CONTENT_REPOSITORY_DRIVER=postgres
CONTENT_POSTGRES_READ_URL=postgresql://agent_build_reader:replace-reader-password@127.0.0.1:5432/agent_build
CONTENT_POSTGRES_WRITE_URL=postgresql://agent_build_writer:replace-writer-password@127.0.0.1:5432/agent_build
CONTENT_POSTGRES_SSL=false

# Notion 图片继续走现有 Supabase Storage；仅保留在服务端。
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
SUPABASE_SCHEMA=public
NOTION_STORAGE_BUCKET=notion-assets

# 灰度期可暂时保留浏览器 anon fallback；确认 Content API 稳定后删除。
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-browser-anon-key
