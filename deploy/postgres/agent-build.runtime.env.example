# 自建 PostgreSQL 的生产运行时样板（不使用 Supabase）。
# 复制到服务器私有 .env；替换密码后 chmod 600，禁止提交真实值。

CONTENT_API_ENABLED=1
NEXT_PUBLIC_CONTENT_API_BASE_URL=/agent-build/api/content/v1
CONTENT_ASSET_PUBLIC_BASE_URL=/agent-build/api/content/v1/assets
CONTENT_REPOSITORY_DRIVER=postgres
CONTENT_POSTGRES_READ_URL=postgresql://agent_build_reader:replace-reader-password@127.0.0.1:5432/agent_build
CONTENT_POSTGRES_WRITE_URL=postgresql://agent_build_writer:replace-writer-password@127.0.0.1:5432/agent_build
CONTENT_POSTGRES_SSL=false

# Notion 同步直接把图片与文章写入 PostgreSQL。NOTION_TOKEN 只供服务端使用。
NOTION_TOKEN=replace-with-notion-token
NOTION_DRY_RUN=false
