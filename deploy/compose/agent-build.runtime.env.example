# 运行时私有配置样板。复制为 agent-build.runtime.env 后仅上传到部署机，禁止提交真实密钥。
# 站点仅会接收 NEXT_PUBLIC_* 字段；数据库密码、service role 只给 content-api / worker。

# 当前站点浏览器只读同源 Content API；不要部署成 disabled，否则页面会显示
# content_backend_unavailable。数据库密钥只给 runtime env，浏览器只拿到同源路径。
CONTENT_API_ENABLED=1
NEXT_PUBLIC_CONTENT_API_BASE_URL=/agent-build/api/content/v1

# 当前生产内容仓库为 PostgreSQL-only；Content API、news-collector 和
# frontier/interview push 共用这组私有配置。
CONTENT_REPOSITORY_POSTGRES_ONLY=true
CONTENT_REPOSITORY_DRIVER=postgres
CONTENT_POSTGRES_URL=postgresql://content_app:replace-password@pgsql.internal:5432/agent_build
CONTENT_POSTGRES_SSL=true

# 如需最小权限拆分，可改用读写分离连接串：
# CONTENT_POSTGRES_READ_URL=postgresql://content_reader:replace-password@pgsql.internal:5432/agent_build
# CONTENT_POSTGRES_WRITE_URL=postgresql://content_writer:replace-password@pgsql.internal:5432/agent_build

# 附件不在 MySQL 内：当前 Notion 图片仍使用 Supabase Storage。完全移除 Supabase 前，
# 先迁移 notion-assets 并部署 AssetStore（S3/MinIO/OSS/COS）适配器；CONTENT_ASSET_PUBLIC_BASE_URL 尚未被运行时代码消费。
